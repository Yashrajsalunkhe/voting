// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  urn       String   @unique
  motherName String
  year      String   // 'second-year' | 'third-year' | 'final-year'
  hasVoted  Boolean  @default(false)
  votedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes            Vote[]
  secondYearVotes  SecondYearVotes[]
  thirdYearVotes   ThirdYearVotes[]
  finalYearVotes   FinalYearVotes[]

  @@map("students")
}

model Candidate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  position    String   // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER
  description String?
  imageUrl    String?
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes            Vote[]
  secondYearVotes  SecondYearVotes[]
  thirdYearVotes   ThirdYearVotes[]
  finalYearVotes   FinalYearVotes[]

  @@map("candidates")
}

model Vote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  candidateId String   @db.ObjectId
  position    String   // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER
  votedAt     DateTime @default(now())

  student   Student   @relation(fields: [studentId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([studentId, position])
  @@map("votes")
}

model SecondYearVotes {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  urn           String
  studentId     String   @db.ObjectId
  candidateId   String   @db.ObjectId
  candidateName String
  position      String   // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER
  votedAt       DateTime @default(now())

  student   Student   @relation(fields: [studentId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([urn, position])
  @@map("secondyearvotes")
}

model ThirdYearVotes {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  urn           String
  studentId     String   @db.ObjectId
  candidateId   String   @db.ObjectId
  candidateName String
  position      String   // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER
  votedAt       DateTime @default(now())

  student   Student   @relation(fields: [studentId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([urn, position])
  @@map("thirdyearvotes")
}

model FinalYearVotes {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  urn           String
  studentId     String   @db.ObjectId
  candidateId   String   @db.ObjectId
  candidateName String
  position      String   // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER
  votedAt       DateTime @default(now())

  student   Student   @relation(fields: [studentId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([urn, position])
  @@map("finalyearvotes")
}