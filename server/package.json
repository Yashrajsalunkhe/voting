{
  "name": "voting1-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "npm run clean && npm run build:frontend && npm run build:server",
    "build:frontend": "cd ../frontend && npm install && npm run build && cp -r dist ../server/public",
    "build:server": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "start:dev": "npm run dev",
    "clean": "rm -rf dist public",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "tsc --noEmit --skipLibCheck",
    "import-students": "tsx import-students.ts",
    "import-candidates": "tsx import-candidates.ts",
    "verify-students": "tsx verify-students.ts"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "mongoose": "^8.16.5",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^22.12.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3"
  }
}
